<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.springboot.demomall.mapper.NewsMapper">

    <select id="getAllNews" resultType="org.springboot.demomall.entity.News">
        SELECT * FROM news ORDER BY show_order ASC LIMIT 5
    </select>
</mapper>
